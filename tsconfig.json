{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["chrome", "node", "vitest/globals"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "entrypoints/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "wxt.config.ts"
  ],
  "exclude": ["old", "_src", "dist"]
}
