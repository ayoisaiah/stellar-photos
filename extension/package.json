{
	"name": "stellar-photos",
	"type": "module",
	"version": "5.0.0",
	"description": "Beautiful high-res photos in your browser tabs. Available for Google Chrome, Microsoft Edge, Brave, Vivaldi and Firefox",
	"main": "src/js/index.js",
	"repository": "git@github.com:ayoisaiah/stellar-photos.git",
	"author": "Ayooluwa Isaiah <ayo@freshman.tech>",
	"license": "MIT",
	"scripts": {
		"firefox:dev": "BROWSER=firefox nodemon build.js",
		"chrome:dev": "BROWSER=chrome nodemon build.js",
		"edge:dev": "BROWSER=edge nodemon build.js",
		"firefox:prod": "BROWSER=firefox NODE_ENV=production node build.js",
		"chrome:prod": "BROWSER=chrome NODE_ENV=production node build.js",
		"edge:prod": "BROWSER=edge NODE_ENV=production node build.js",
		"test": "",
		"lint": "",
		"fmt": "",
		"prepare": "husky install"
	},
	"devDependencies": {},
	"dependencies": {},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.js": [
			""
		],
		"*.css": [
			"stylelint --fix"
		],
		"*.html": [
			""
		]
	}
}
