{
  "name": "stellar-photos",
  "type": "module",
  "version": "5.0.0",
  "description": "Experience a beautiful high-resolution photo every time you open a new browser tab. Fast, customizable, and clutter-free",
  "repository": "git@github.com:ayoisaiah/stellar-photos.git",
  "author": "Ayooluwa Isaiah <ayo@freshman.tech>",
  "license": "MIT",
  "scripts": {
    "build": "npm run chrome:prod && npm run firefox:prod",
    "firefox:dev": "wxt -b firefox --mv3",
    "chrome:dev": "wxt -b chrome --mv3",
    "firefox:prod": "wxt build -b firefox --mv3",
    "chrome:prod": "wxt build -b chrome --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run tests",
    "pretest:e2e": "STELLAR_OUT_DIR=.wxt-e2e-dist UNSPLASH_ACCESS_KEY=test-key SMITHSONIAN_API_KEY=test-key wxt build -b chrome --mv3",
    "test:e2e": "playwright test",
    "lint": "biome lint .",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "fmt": "biome format --write .",
    "check": "biome check .",
    "prepare": "wxt prepare && simple-git-hooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "lint-staged": {
    "*.ts": "biome check --write --no-errors-on-unmatched"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@lucide/icons": "^1.53.0",
    "lit": "^3.3.3"
  }
}
