{
  "manifest_version": 3,
  "name": "Stellar Photos",
  "version": "5.0.0",
  "description": "Experience a beautiful photo from Unsplash every time you open a new browser tab",
  "icons": {
    "48": "icons/48.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://api.unsplash.com/*",
    "https://images.unsplash.com/*"
  ]
}
